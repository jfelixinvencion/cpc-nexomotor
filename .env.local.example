# Copia este archivo a .env.local y reemplaza los valores.
# AUTH_SESSION_SECRET es server-only: nunca uses el prefijo NEXT_PUBLIC_.
# Genera un valor largo y aleatorio (por ejemplo 48+ bytes en hex).
# En producción (Vercel) configura la misma variable con un secreto real distinto.

AUTH_SESSION_SECRET=reemplazar-por-un-secreto-largo-aleatorio
